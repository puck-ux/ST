{
  "name": "st-sample-project",
  "version": "0.1.0",
  "description": "Software Testing 2022-23 Sample Test Project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "cross-env DOTENV_CONFIG_PATH=.env jest --setupFiles dotenv/config --forceExit && node db-cleanup.js",
    "test:inproc": "jest --config jest.inproc.config.js --coverage",
    "test:api": "cross-env DOTENV_CONFIG_PATH=.env jest --setupFiles dotenv/config --forceExit __tests__/api && node db-cleanup.js",
    "mutation": "stryker run",
    "lint": "eslint app.js server.js endpoints models",
    "performance": "artillery run __tests__/performance/performance-test.yml --output reports/performance.json && node db-cleanup.js",
    "report": "artillery report --output reports/performance.html reports/performance.json"
  },
  "keywords": [
    "software",
    "testing",
    "sample",
    "project"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.7",
    "bcrypt": "latest",
    "body-parser": "latest",
    "cli-table": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "^4.19.2",
    "express-flash": "latest",
    "express-jwt": "^8.4.1",
    "express-session": "latest",
    "express-validator": "latest",
    "jest": "latest",
    "jest-measure": "latest",
    "jsonwebtoken": "latest",
    "jwks-rsa": "latest",
    "mongoose": "^6.10.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^1.7.1",
    "jest-junit": "^17.0.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14"
    }
  }
}
